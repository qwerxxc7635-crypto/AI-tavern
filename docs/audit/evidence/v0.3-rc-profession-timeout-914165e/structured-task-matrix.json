      "stream": false,
      "cancellation": "Queue -> Provider -> HTTP",
      "commit": "inside deduplicated Queue"
    },
    {
      "group": "traits-and-background",
      "tasks": ["GENERATE_CHARACTER_TRAITS", "COMPLETE_CHARACTER_BACKGROUND"],
